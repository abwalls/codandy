CODANDY_ENVIRONMENT=development
CODANDY_ALLOWED_ORIGINS=["http://localhost:3000"]
# Host names the API answers to (DNS-rebinding protection). Add a name only for a
# separately secured backend, such as the host in the frontend's CODANDY_API_URL.
CODANDY_ALLOWED_HOSTS=["localhost","127.0.0.1","::1"]
CODANDY_WORKSPACE_ROOT=.workspaces
# Optional local single-process report storage. Leave unset for in-memory reports.
# CODANDY_REPORT_ROOT=.reports
CODANDY_MAX_REPOSITORY_MB=250
CODANDY_MAX_UPLOAD_MB=100
CODANDY_MAX_FILE_COUNT=25000
CODANDY_MAX_PATH_DEPTH=30
CODANDY_CLONE_TIMEOUT_SECONDS=120
CODANDY_ANALYSIS_TIMEOUT_SECONDS=120
CODANDY_MAX_SOURCE_BYTES=1000000
CODANDY_MAX_NODES=50000
CODANDY_MAX_JOBS=10
CODANDY_MAX_VIEWER_FILE_BYTES=131072
CODANDY_MAX_VIEWER_TOTAL_BYTES=4194304
# Local-only ChatGPT subscription connection. Authentication is managed by Codex.
# CODANDY_CODEX_ENABLED=true
# CODANDY_CODEX_EXECUTABLE=C:/path/to/codex.exe
# CODANDY_CODEX_HOME=.codex-codandy

# Read-only Sentry Cloud event retrieval; token stays on this local backend.
# Use a token with event:read and access to the selected organization.
# CODANDY_SENTRY_TOKEN=
# CODANDY_SENTRY_ORGANIZATION=your-organization-slug
# CODANDY_SENTRY_HOST=sentry.io
# Regional hosts: us.sentry.io or de.sentry.io. Restart after changing settings.

# Local saved investigations (separate from expiring analysis reports).
CODANDY_BOARD_ROOT=.boards
CODANDY_INVESTIGATION_ROOT=.investigations

# Local Linear ticket creation. Keep the key backend-only; restart after edits.
# CODANDY_LINEAR_API_KEY=
CODANDY_INTEGRATION_ROOT=.integrations

# Sentry project browsing additionally requires org:read; event:read still covers issue/event reads.
