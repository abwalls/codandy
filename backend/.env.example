CODE_ATLAS_ENVIRONMENT=development
CODE_ATLAS_ALLOWED_ORIGINS=["http://localhost:3000"]
CODE_ATLAS_WORKSPACE_ROOT=.workspaces
# Optional local single-process report storage. Leave unset for in-memory reports.
# CODE_ATLAS_REPORT_ROOT=.reports
CODE_ATLAS_MAX_REPOSITORY_MB=250
CODE_ATLAS_MAX_FILE_COUNT=25000
CODE_ATLAS_MAX_PATH_DEPTH=30
CODE_ATLAS_CLONE_TIMEOUT_SECONDS=120
CODE_ATLAS_ANALYSIS_TIMEOUT_SECONDS=120
CODE_ATLAS_MAX_SOURCE_BYTES=1000000
CODE_ATLAS_MAX_NODES=50000
CODE_ATLAS_MAX_JOBS=10
CODE_ATLAS_MAX_VIEWER_FILE_BYTES=131072
CODE_ATLAS_MAX_VIEWER_TOTAL_BYTES=4194304
# Local-only ChatGPT subscription connection. Authentication is managed by Codex.
# CODE_ATLAS_CODEX_ENABLED=true
# CODE_ATLAS_CODEX_EXECUTABLE=C:/path/to/codex.exe
# CODE_ATLAS_CODEX_HOME=.codex-atlas
