CODANDY_ENVIRONMENT=development
CODANDY_ALLOWED_ORIGINS=["http://localhost:3000"]
CODANDY_WORKSPACE_ROOT=.workspaces
# Optional local single-process report storage. Leave unset for in-memory reports.
# CODANDY_REPORT_ROOT=.reports
CODANDY_MAX_REPOSITORY_MB=250
CODANDY_MAX_FILE_COUNT=25000
CODANDY_MAX_PATH_DEPTH=30
CODANDY_CLONE_TIMEOUT_SECONDS=120
CODANDY_ANALYSIS_TIMEOUT_SECONDS=120
CODANDY_MAX_SOURCE_BYTES=1000000
CODANDY_MAX_NODES=50000
CODANDY_MAX_JOBS=10
CODANDY_MAX_VIEWER_FILE_BYTES=131072
CODANDY_MAX_VIEWER_TOTAL_BYTES=4194304
# Local-only ChatGPT subscription connection. Authentication is managed by Codex.
# CODANDY_CODEX_ENABLED=true
# CODANDY_CODEX_EXECUTABLE=C:/path/to/codex.exe
# CODANDY_CODEX_HOME=.codex-codandy
